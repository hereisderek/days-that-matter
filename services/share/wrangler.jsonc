{
  "name": "dtm-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/e/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtm-share",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "MAINTENANCE": "0", "VERSION": "dev" }
}
